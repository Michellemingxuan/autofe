__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
outputs/
# Use-case folders: ignore the tables, keep the build scripts. A table is
# rebuildable from its prepare.py, which downloads the source and verifies the
# result against the config, so committing it would add megabytes of binary for
# something one command reproduces.
data/*/modeling.parquet
data/*/train.parquet
data/*/valid.parquet
data/*/test.parquet
data/*/raw/
# Kept on purpose: prepare.py, column_mapping.csv and column_descriptions.json.
# The descriptions are what a discovery run reads to know what a column means,
# and they are small, reviewable, and awkward to regenerate by hand.
.DS_Store
