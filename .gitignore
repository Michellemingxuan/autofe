__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
outputs/
# Credentials: OPENAI_API_KEY and friends. Never committed.
.env
# Dataset folders: ignore the tables, keep what builds them. Every table is
# rebuilt by the dataset's prepare notebook, which downloads the source and
# checks the result against the config, so committing it would add megabytes of
# binary for something one run reproduces.
data/*/train.csv
data/*/valid.csv
data/*/test.csv
data/*/few_shot.csv
data/*/screen_train.csv
data/*/screen_valid.csv
data/*/raw/
# Domain context for a private use case: the prompt reads it, git never sees it.
data/*/task_context.md
# Kept on purpose: prepare.ipynb, column_mapping.csv and column_descriptions.json.
# The descriptions are what a discovery run reads to know what a column means,
# and they are small, reviewable, and awkward to regenerate by hand.
.DS_Store
